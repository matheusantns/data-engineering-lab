# Platform image for dagster-webserver and dagster-daemon (no pipeline code).
# Follows the official Dagster OSS Docker Compose pattern.

FROM python:3.12-slim

RUN pip install --no-cache-dir \
    dagster \
    dagster-graphql \
    dagster-webserver \
    dagster-postgres \
    dagster-docker

ENV DAGSTER_HOME=/opt/dagster/dagster_home/

RUN mkdir -p $DAGSTER_HOME

COPY dagster.yaml $DAGSTER_HOME/dagster.yaml.template
COPY workspace.yaml $DAGSTER_HOME/
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

WORKDIR $DAGSTER_HOME

ENTRYPOINT ["/docker-entrypoint.sh"]
