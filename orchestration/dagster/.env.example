# Copy to orchestration/dagster/.env (gitignored) or export in your shell.
# Never commit real passwords, secrets.toml, or profiles.yml.

# Dagster metadata Postgres (Compose service `postgres` — not the ecommerce sample DB)
DAGSTER_POSTGRES_USER=dagster_user
DAGSTER_POSTGRES_PASSWORD=dagster_password
DAGSTER_POSTGRES_DB=dagster_db

# Optional overrides for secret mounts on the user_code service
# (paths relative to this compose file)
# DLT_SECRETS_DIR=../../pipelines/ecommerce_bronze/.dlt
# DBT_PROFILES_FILE=../../dw/snowflake/analytics/profiles.yml

# REQUIRED for DockerRunLauncher: absolute *host* paths (forward slashes OK on Windows).
# Docker resolves these via docker.sock on the host, not inside the daemon container.
# DLT_SECRETS_HOST_PATH=C:/Users/YOU/Documents/Coding/data-engineering-lab/pipelines/ecommerce_bronze/.dlt
# DBT_PROFILES_HOST_PATH=C:/Users/YOU/Documents/Coding/data-engineering-lab/dw/snowflake/analytics/profiles.yml

# dbt Snowflake env (same names as RUNBOOK; passed into user_code + run containers)
# DBT_SNOWFLAKE_ACCOUNT=<organization-account>
# DBT_SNOWFLAKE_USER=LOADER
# DBT_ENV_SECRET_SNOWFLAKE_PASSWORD=<loader-password>

# Host Postgres for Bronze (erp sample on host port 5433):
# In pipelines/ecommerce_bronze/.dlt/secrets.toml use host.docker.internal
# (not localhost) when the code location / run containers use Docker on Windows.
